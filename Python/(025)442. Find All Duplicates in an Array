class Solution:
    def findDuplicates(self, nums: List[int]) -> List[int]:
        """seen=set(). this is not auxillary space beacsue of set 
        result=[]
        for num in nums:
            if num in seen:
                result.append(num)
            seen.add(num)
        return result"""
        result=[]
        for i in range(len(nums)):
            ind=abs(nums[i])-1
            if nums[ind]<0:
                result.append(ind+1)
            else:
                nums[ind]=-nums[ind]
        return result