class Solution:
    def removeDuplicates(self, nums: List[int]) -> int:
        # two-pointer approach: i tracks the write position,
        # j scans forward looking for a new unique value
        i = 1
        for j in range(1, len(nums), 1):
            if nums[j] != nums[j - 1]:
                nums[i] = nums[j]
                i += 1
        return i