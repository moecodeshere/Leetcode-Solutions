class Solution:
    def removeElement(self, nums: List[int], val: int) -> int:
        #a simple for loop then we simply check if the value of the elelmtn is equal to the value given we simply move to next if not we add it adn increment the pointer
        
        i=0
        for j in range(len(nums)):
            if nums[j]!=val:
                nums[i]=nums[j]
                i+=1
        return i