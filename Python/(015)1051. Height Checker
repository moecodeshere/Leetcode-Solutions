class Solution:
    def heightChecker(self, heights: List[int]) -> int:
        #naive solution is ot create anew array and sort it and then compare 
        # abbeacuse of constarints we can use counting sort 
        #in counting sort we simply make an array of length 100 and then we simply countth efrequrncy of each wiuth index as the height and then we simply run a for loop for each heihgt/ f requency i.e. from 0 to 100 
        count = [0]*101 
        for i in range(len(heights)):
            count[heights[i]] +=1
        
        ans=0
        j=0
        for i in range(1,101):
            for _ in range(count[i]):
                if heights[j] !=i:
                    ans+=1
                j+=1

        return ans