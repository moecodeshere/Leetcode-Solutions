class Solution:
    def replaceElements(self, arr: List[int]) -> List[int]:
        n=len(arr)
        currmax=arr[n-1]
        j=n-1
        while(j>=0):
            temp=arr[j]
            if(arr[j]<currmax):
                arr[j]=currmax
            elif(arr[j]>currmax):
                arr[j]=currmax
                currmax=temp
            j-=1
        arr[n-1]=-1
        return arr
        