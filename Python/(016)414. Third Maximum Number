class Solution:
    def thirdMax(self, nums: List[int]) -> int:
        first=sec=thir=None
        for num in nums:
            if num== first or num ==sec or num==thir:
                continue

            if first is None or num > first:
                thir=sec
                sec=first
                first=num
            elif sec is None or num>sec:
                thir=sec
                sec=num
            elif thir is None or num>thir:
                thir =num
            
        if thir is None:
                return first
        return thir